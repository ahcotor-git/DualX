<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建放行明文 HTTP，且只限本机回环地址。

  现场自测走 `adb reverse tcp:11001 tcp:11001`，设备侧访问 `http://127.0.0.1:11001`；
  Android 9+ 默认禁明文 HTTP，不配此文件会直接抛 CLEARTEXT_NOT_PERMITTED。
  只放行 127.0.0.1 / localhost：局域网地址与公网地址在 debug 下同样被禁，
  避免误把明文流量放行到整网。release 构建不含本文件，默认全禁。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
