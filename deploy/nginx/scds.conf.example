# Include in the cloud Nginx http context (e.g. conf.d).
# Replace the domain, certificate files and reserved proxy port before use.
# FRPS must listen on 127.0.0.1:18081, not a public interface.
map $http_upgrade $scds_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name scds.example.invalid;
    return 308 https://scds.example.invalid$request_uri;
}

server {
    listen 443 ssl;
    server_name scds.example.invalid;

    ssl_certificate /etc/nginx/scds-certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/scds-certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    if ($host != scds.example.invalid) {
        return 444;
    }

    # Confirm request limits against the upload contract before production.
    client_max_body_size 20m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $scds_connection_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;

    # Keep management endpoints local, even when a caller has an ADMIN token.
    location = /actuator {
        return 404;
    }
    location ^~ /actuator/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:18081;
    }
}
