# ============================================================================
# scds-next 本机开发凭据模板
#
# 用法：复制为 .env（同目录）后把值换成随机串，.env 已被 .gitignore 忽略。
# 生成随机串：openssl rand -hex 24   （或任意 48 位十六进制）
#
# 这些变量由 compose.yaml（建容器/建账号）与
# scds-app/src/main/resources/application-local.yml（Spring 读库）共同使用，
# 所以两处必须指向同一份 .env，改了要一起生效。
# ============================================================================

# MySQL 容器 root 口令：仅用于容器初始化与运维登录，应用不使用
SCDS_MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password

# 应用账号 scds_app 的口令：Spring Boot 连库用这个
SCDS_MYSQL_PASSWORD=replace-with-a-random-app-password

# 覆盖数据库连接串（默认 jdbc:mysql://127.0.0.1:13306/scds_next，通常无需设置）
# SCDS_JDBC_URL=jdbc:mysql://127.0.0.1:13306/scds_next?rewriteBatchedStatements=true

# 必须通过进程环境 SCDS_PROFILE=local 或 --spring.profiles.active=local 激活本地导入。
# 仅把 SCDS_PROFILE 写入本文件不能触发尚未激活的 application-local.yml。
# 生产不使用 local profile；应显式导入生产配置文件，详见 docs/environments.md。

# 全部业务部署本地，云端仅Nginx/FRPS入口；生产本地使用独立密钥，不能沿用下方dev-keys。
# 账号/设备统一本地签发；远端JWKS必须为空，非空配置绑定失败。
SCDS_JWT_SIGNING=true
SCDS_JWKS_URI=

# 初始管理员账号：应用首次启动时若该账号不存在，就用下面这行口令建号
# （BCrypt cost 10，与其他口令同一策略）。建号成功后**建议把这一行删掉**——
# 此后口令只以散列形式存在于库中，进程不再读它。
#
# 刻意不在 V9 迁移里种任何默认账号：迁移文件会进版本库，写死初始口令等于
# 所有客户共用同一把钥匙；写死散列同样不行——散列可被拿去撞库，且运维换口令
# 就得改迁移文件。散列由应用在运行时生成，部署侧只需提供一个随机口令。
SCDS_ADMIN_USERNAME=admin
SCDS_ADMIN_PASSWORD=replace-with-a-random-admin-password
# SCDS_ADMIN_DISPLAY_NAME=现场管理员

# ===== 鉴权密钥（本机开发专用；本地生产另配独立密钥，见 docs/architecture.md 第0节）=====
# dev-keys/ 下的这对密钥是**公开的测试密钥**：它随仓库分发，因此只允许用于本机开发与
# 自动化测试。任何对外可达的实例用它签名，等于把签发权交给了所有看过这个仓库的人。
# 路径相对**运行目录**：从 scds-app/ 启动时是 ../dev-keys/...，从仓库根启动时去掉 "../"。
SCDS_JWT_PUBLIC_KEY_FILE=../dev-keys/dev-jwt-public.pem
SCDS_JWT_PRIVATE_KEY_FILE=../dev-keys/dev-jwt-private.pem

# 可选公网入口：FRPC从进程环境读取，不自动加载本文件。以下仅部署键名与非秘密样例。
# FRPS控制端口7001/代理端口18081尚未分配，不能占用或改动ZAA的服务和凭据。
# 不启用FRPC也能在LAN本地登录/刷新；云端不部署业务或持有业务JWT私钥。
# SCDS_FRP_SERVER_ADDR=frps.scds.example.invalid
# SCDS_FRP_SERVER_PORT=7001
# SCDS_FRP_SERVER_NAME=frps.scds.example.invalid
# SCDS_FRP_CA_FILE=E:/ScdsConfig/frps-ca.pem
# SCDS_FRP_TOKEN=provided-via-protected-service-environment
# SCDS_FRP_PROXY_NAME=scds-customer-http
# SCDS_FRP_LOCAL_IP=127.0.0.1
# SCDS_FRP_REMOTE_PORT=18081
