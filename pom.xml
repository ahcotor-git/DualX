<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.dualx</groupId>
    <artifactId>scds-next</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>scds-next</name>
    <description>SCDS 实兵演习系统 · C 端重构（大爆炸全量重写）</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方版本（Spring Boot BOM 未覆盖的部分） -->
        <hutool.version>5.8.32</hutool.version>
        <jserialcomm.version>2.11.0</jserialcomm.version>
        <!-- 全局 ID 统一 UUIDv7（char(36)）；uuid-creator 无强制传递依赖 -->
        <uuid-creator.version>6.1.1</uuid-creator.version>
    </properties>

    <modules>
        <module>scds-protocol</module>
        <module>scds-solver</module>
        <module>scds-gateway</module>
        <module>scds-core</module>
        <module>scds-api</module>
        <module>scds-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- ===== 内部模块（统一版本） ===== -->
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-solver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dualx</groupId>
                <artifactId>scds-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ===== 第三方 ===== -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-json</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fazecast</groupId>
                <artifactId>jSerialComm</artifactId>
                <version>${jserialcomm.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>uuid-creator</artifactId>
                <version>${uuid-creator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 仓储层集成测试以 *IT 命名（需本机 MySQL 容器在跑）。
                 surefire 默认只收集 *Test，会把 *IT 静默跳过；这里显式纳入
                 test 阶段，保证 `mvn install` 真的执行了它们而不是假装通过。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
