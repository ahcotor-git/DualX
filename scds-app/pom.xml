<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dualx</groupId>
        <artifactId>scds-next</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scds-app</artifactId>
    <name>scds-app</name>
    <description>
        启动装配：唯一可执行 fat jar。通过 Spring Profile 切换部署形态
        CLOUD（云管多租户）/ PRIVATE（私有化单机），由 deployment-mode 驱动。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.dualx</groupId>
            <artifactId>scds-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dualx</groupId>
            <artifactId>scds-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>scds-next</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.dualx.ScdsNextApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
