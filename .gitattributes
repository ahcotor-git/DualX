# 行尾与二进制属性（段 87 / A-3）
# 目标：仓库内与检出均统一 LF，消除 Windows 上 core.autocrlf 造成的行尾漂移与噪音告警。
# 依据 gitattributes(5)：二进制不做任何转换；Windows 批处理保留 CRLF。

# 默认：自动识别文本，检出用 LF
* text=auto eol=lf

# —— 文本：显式声明主要源码 / 配置 / 文档为 LF ——
*.md         text eol=lf
*.txt        text eol=lf
*.java       text eol=lf
*.kt         text eol=lf
*.kts        text eol=lf
*.gradle     text eol=lf
*.dart       text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.xml        text eol=lf
*.json       text eol=lf
*.properties text eol=lf
*.sql        text eol=lf
*.sh         text eol=lf
*.ps1        text eol=lf
*.mjs        text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.pem        text eol=lf

# —— Windows 批处理保留 CRLF ——
*.bat        text eol=crlf
*.cmd        text eol=crlf

# —— 二进制：禁止行尾 / EOL 转换 ——
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jar      binary
*.jks      binary
*.keystore binary
*.p12      binary
*.pfx      binary
*.apk      binary
*.aab      binary
*.so       binary
*.dll      binary
*.dylib    binary
*.exe      binary
*.lib      binary
*.xlsx     binary
*.zip      binary
*.gz       binary
