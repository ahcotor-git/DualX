<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dualx</groupId>
        <artifactId>scds-next</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scds-api</artifactId>
    <name>scds-api</name>
    <description>
        接口适配层：REST（HTTP 11001，契约见 docs/openapi）+ WebSocket 实时推送。
        阶段 1 仅骨架，接口实现见阶段 2。
    </description>

    <dependencies>
        <dependency>
            <groupId>com.dualx</groupId>
            <artifactId>scds-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 只取「验签 + 由 claim 还原身份」这一半能力（NimbusJwtDecoder /
             JwtAuthenticationToken）。刻意不引 spring-security-oauth2-authorization-server：
             本项目不需要 OIDC 那整套发现与注册文档，签发由自有 login 端点完成。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- 本模块的 Controller 直接使用 @Valid / @Validated / @Min 等约束注解，
             显式声明此依赖，不依赖经由 scds-core 的传递依赖。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MockMvc / JsonPath / JUnit 5：骨架期冒烟测试用（test scope，不参与打包） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
